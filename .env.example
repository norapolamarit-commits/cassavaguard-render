# Runtime
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-bytes
DATABASE_URL=sqlite:///./database/cassavaguard.db
DATA_DIR=.

# Local behaviour. Keep demo seeding off when working with real fields.
SEED_DEMO_DATA=false
EXPOSE_RESET_TOKEN=true
ENABLE_API_DOCS=true
AUTH_REQUIRED=false

# Used only when AUTH_REQUIRED=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://127.0.0.1:8800

# Password-reset delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Browser/API policy
CORS_ORIGINS=http://127.0.0.1:8800,http://localhost:8800
TRUST_PROXY_HEADERS=false
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=30
ASSET_TOKEN_EXPIRE_MINUTES=10

# Data and resource limits
ENVIRONMENTAL_DATA_MODE=live
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_CACHE_TTL_SECONDS=21600
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
SATELLITE_MAX_CLOUD_PCT=70
SATELLITE_LOOKBACK_DAYS=45
SATELLITE_GRID_RADIUS_M=120
AI_MIN_CONFIDENCE=0.65
AI_MIN_MARGIN=0.10
# Set true only after independent validation on representative Thai field photos.
AI_FIELD_VALIDATED=false
# approved_only blocks every artifact that has not passed the production gate.
# review_only may execute those artifacts but every result remains review-required.
AI_SERVING_MODE=review_only
USE_CNN=true
USE_FUSION=false
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_CSV_UPLOAD_BYTES=2097152
MAX_IMAGE_PIXELS=25000000
MAX_CSV_ROWS=10000
LOG_RETENTION_ROWS=10000
